APP_NAME=Daybook API
ENVIRONMENT=development

DATABASE_URL=postgresql+asyncpg://daybook:daybook@localhost:5432/daybook

JWT_SECRET=change-me-to-a-long-random-value
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=30

CORS_ORIGINS=["http://localhost:5173"]

# Auth rate limits (per IP) default to 5/min register, 10/min login, 30/min
# refresh — plenty for a real user, tight against abuse. Only override these
# if you're running a burst of E2E tests against one long-lived local server
# and keep tripping them; production should leave them at the defaults.
# REGISTER_RATE_LIMIT=1000/minute
# LOGIN_RATE_LIMIT=1000/minute
# REFRESH_RATE_LIMIT=1000/minute
